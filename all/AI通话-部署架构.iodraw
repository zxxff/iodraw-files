        </mxCell>
        <mxCell id="rds" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#78350F;margin-bottom:8px;&quot;&gt;RDS MySQL 8&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;• 业务表 · DB 队列&lt;br&gt;• 日结 / 对账数据&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=14;spacingBottom=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="265" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="backup-note" value="自动备份 + 每周导出 OSS" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#92400E;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="900" y="373" width="290" height="22" as="geometry" />
        </mxCell>
        <mxCell id="oss" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#78350F;margin-bottom:8px;&quot;&gt;OSS&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;• 录音转存（7 天内）&lt;br&gt;• 导出文件 / 备份&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=14;spacingBottom=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="450" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#4C1D95;margin-bottom:8px;&quot;&gt;云监控 + 告警&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;• 进程心跳 · 失败率&lt;br&gt;• 磁盘 / 余额&lt;br&gt;• → 企业微信 / 钉钉&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=14;spacingBottom=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="620" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#334155;margin-bottom:8px;&quot;&gt;运行保障&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;• systemd Restart=always&lt;br&gt;• 开机自启 · SIGTERM 优雅退出&lt;br&gt;• logrotate 日志轮转&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=14;spacingBottom=12;" parent="1" vertex="1">
