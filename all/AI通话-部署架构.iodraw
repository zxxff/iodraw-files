        <mxCell id="callee" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#334155;margin-bottom:8px;&quot;&gt;被叫用户&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;• 运营商线路&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=14;spacingBottom=12;" parent="1" vertex="1">
          <mxGeometry x="1560" y="560" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;队列&lt;/b&gt;　MySQL 表 + SKIP LOCKED（暂不引入 Redis / MQ）　　&lt;b&gt;录音&lt;/b&gt;　URL 7 天内转存 OSS，不落本地盘　　&lt;b&gt;回执&lt;/b&gt;　Web 只落库，加工交给 Worker　　&lt;b&gt;可靠性&lt;/b&gt;　心跳 + 每日对账 + RDS 备份" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontSize=12;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="40" y="940" width="1920" height="58" as="geometry" />
